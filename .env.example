SECRET_KEY=replace-this-with-a-real-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
WEB_PORT=8000
HTTPS_PORT=8443
DATABASE_URL=postgresql://nexora:nexora-dev-password@127.0.0.1:5432/nexora
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-this-development-password
# If Docker Hub is unavailable on your network, override these with a
# trusted internal mirror without changing docker-compose.yml.
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# CADDY_IMAGE=caddy:2-alpine
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8443
DEFAULT_FROM_EMAIL=no-reply@nexora.local
# برای ارسال واقعی، EMAIL_BACKEND را SMTP کن و این مقادیر را با اطلاعات
# حساب ایمیل فروشگاه پر کن. رمز را هرگز در Git commit نکن.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
USE_REDIS=True
